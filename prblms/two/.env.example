PORT=4000

# ═══════════════════════════════════════════════════════════════════
# TVSMNEPA EXTERNAL READ-ONLY API CONFIGURATION
# Local example:      http://localhost:5000/api/v1/external
# Production example: https://your-tvsmnepa-backend.onrender.com/api/v1/external
# ═══════════════════════════════════════════════════════════════════
TVSM_API_BASE_URL=http://localhost:5000/api/v1/external

# Generate this key in TVSMNEPA -> Admin -> Settings -> External Read-Only API Keys
TVSM_API_KEY=tvsm_ro_paste_your_secret_key_here

# Optional: Set a passcode to require login before viewing attendance on this site
# Leave empty if anyone visiting this portal page can view read-only attendance
PORTAL_ACCESS_CODE=
